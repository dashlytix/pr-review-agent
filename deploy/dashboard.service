[Unit]
Description=ai-ci-agent admin dashboard (cmd/dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ai-ci-agent-dashboard
EnvironmentFile=/etc/ai-ci-agent/dashboard.env
Restart=on-failure
RestartSec=5
# Inbound HTTP (the dashboard itself, put behind a reverse proxy that
# terminates TLS -- see deploy/README.md) plus outbound HTTPS (GitHub's
# API and OAuth endpoints) -- no elevated privileges required.
User=ai-ci-agent
Group=ai-ci-agent
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
